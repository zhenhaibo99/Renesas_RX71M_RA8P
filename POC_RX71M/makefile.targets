# Extra images after the ELF link. Debug/Release/HardwareDebug makefiles include this file.
# Intel HEX keeps each load address. BIN is the on-chip ROM window at 0xFFC00000,
# 4 MiB, with gaps filled by 0xFF. It includes the fixed vectors at the top of ROM.

secondary-outputs: POC_RX71M.hex POC_RX71M.bin

POC_RX71M.hex: POC_RX71M.elf
	rx-elf-objcopy "POC_RX71M.elf" -O ihex -I elf32-rx-be-ns "POC_RX71M.hex"

POC_RX71M.bin: POC_RX71M.elf
	rx-elf-objcopy "POC_RX71M.elf" -I elf32-rx-be-ns -O binary --gap-fill=255 -j .text -j .rvectors -j .init -j .fini -j .rodata -j .exvectors -j .fvectors "POC_RX71M.bin"

clean: clean-extra-images

clean-extra-images:
	-$(RM) POC_RX71M.hex POC_RX71M.bin

.PHONY: clean-extra-images
